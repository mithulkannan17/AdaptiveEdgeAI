# ==========================================================
# AURAFOREST SENTINEL — SMTP LIVE EMAIL CONFIGURATION
# ==========================================================
# To send real emails to your Gmail / Outlook / Yahoo inbox:
#
# FOR GMAIL:
# 1. Go to your Google Account -> Security -> 2-Step Verification.
# 2. At the bottom, click "App passwords".
# 3. Create a new App Password named "AuraForest".
# 4. Copy the 16-character generated password and paste below.
#
# FOR OUTLOOK / OFFICE 365:
# SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# ==========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SSL=false
